# Required: generate distinct values, for example with `openssl rand -hex 32`.
AUTH_KEY=
LB_AUTH_KEY=
PORT=3000
WEBSOCKET_PORT=3001
GROUP=default
CONTRACT=1
SLOTS=10
DEFAULT_TIMEOUT=30000
LOG_LEVEL=info
MAX_LOGS=1000
WEBHOOK_TIMEOUT=5000
WEBHOOK_MAX_RETRIES=3
WEBHOOK_RETRY_DELAY=1000
WEBHOOK_HEADERS={}
OPENAPI_ENABLED=true
REQUEST_BODY_LIMIT=10mb

# Optional MCP: keep empty to disable; use a distinct random token (e.g. openssl rand -hex 32).
MCP_AUTH_KEY=
MCP_CONFIG_PATH=mcp.json
# Browser origins only; native clients do not need this.
MCP_ALLOWED_ORIGINS=
